{
  "name": "@signalsafe/simulator-device",
  "version": "0.16.3",
  "type": "module",
  "description": "Reusable full phone/device simulator UI composition on top of @signalsafe/simulator-react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignalSafeSoftware/simulator-device.git"
  },
  "bugs": {
    "url": "https://github.com/SignalSafeSoftware/simulator-device/issues"
  },
  "homepage": "https://github.com/SignalSafeSoftware/simulator-device#readme",
  "keywords": [
    "react",
    "simulator",
    "device",
    "phone-shell",
    "navigation",
    "training",
    "security-awareness",
    "typescript",
    "signalsafe"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "gallery-dist",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=19.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "yarn typecheck",
    "typecheck": "tsc --noEmit",
    "smoke:package": "node scripts/smoke-package.mjs",
    "publish:dry-run": "npm publish --dry-run",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build && npm run check:gallery && npm run build:gallery",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview:gallery": "vite --config gallery/vite.config.ts",
    "build:gallery": "vite build --config gallery/vite.config.ts",
    "check:gallery": "tsc -p tsconfig.gallery.json"
  },
  "dependencies": {
    "@signalsafe/simulator-core": "0.3.2",
    "@signalsafe/simulator-react": "0.16.3"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vite": "^8.3.0",
    "@signalsafe/simulator-theme-bootstrap": "0.9.2"
  }
}
